# CASACUSIA · Variables de entorno

# Base
NEXT_PUBLIC_SITE_URL=https://casacusia.org

# Mail transactional (contact form, newsletter)
# RESEND_API_KEY: crear en resend.com y verificar el dominio casacusia.org (DNS)
RESEND_API_KEY=
# Remitente del form de contacto (debe estar sobre el dominio verificado en Resend)
CONTACT_FROM_EMAIL="Casacusia Web <somos@casacusia.org>"
CONTACT_TO_EMAIL=somos@casacusia.org

# Supabase (newsletter subscribers storage)
SUPABASE_URL=https://zeozqruwypyjifhvhwll.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Podcast (YouTube Data API v3)
YOUTUBE_API_KEY=
YOUTUBE_PLAYLIST_ID=

# Anti-spam: BotID de Vercel (modo Basic). No usa variables de entorno: se
# activa solo al deployar, con la config de instrumentation-client.ts.
# En local siempre devuelve "humano". Heurísticas propias en lib/antispam.ts.

# Analytics — GA4 Measurement ID (empieza con G-)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Ads — Conversion tracking ID (empieza con AW-)
NEXT_PUBLIC_GOOGLE_ADS_ID=

# ── QR de la lona 3×2 de la Expo ────────────────────────────────────────────
# Opcionales: si no están, next.config.mjs usa los links por defecto.
# Sirven para cambiar el destino desde Vercel sin tocar código (igual requiere
# redeploy, pero nunca reimprimir la cartelería).
LINK_MP_QR_MENSUAL_LIBRE=
LINK_MP_QR_UNICO_LIBRE=
